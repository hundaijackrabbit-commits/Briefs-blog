DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/briefs
CRON_SECRET=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-a-long-random-secret
BRIEFS_BASE_URL=https://briefs.blog
SOURCE_REQUEST_TIMEOUT_MS=12000
SOURCE_MAX_RETRIES=3
WORKER_BATCH_SIZE=25

# Wikimedia asks automated clients to identify themselves.
BRIEFS_USER_AGENT=BriefsBlog/0.8 contact@example.com (+https://briefs.blog)

# Optional market quote adapter. Without it, finance Briefs still use SEC filings but explicitly omit price.
ALPHA_VANTAGE_API_KEY=

# Optional target for deployed evaluation.
BRIEFS_EVAL_BASE_URL=http://localhost:3000
